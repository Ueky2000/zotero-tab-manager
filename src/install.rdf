<?xml version="1.0" encoding="UTF-8"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>tab-groups@local.zotero</em:id>
    <em:name>Tab Manager</em:name>
    <em:version>0.6.1</em:version>
    <em:description>Your tabs, in order.</em:description>
    <em:creator>Ueky2000</em:creator>
    <em:type>2</em:type><em:bootstrap>true</em:bootstrap>
    <em:unpack>false</em:unpack>
    <em:updateURL>https://raw.githubusercontent.com/Ueky2000/zotero-tab-manager/main/updates.json</em:updateURL>
    <em:targetApplication><Description><em:id>zotero@chnm.gmu.edu</em:id><em:minVersion>6.0</em:minVersion><em:maxVersion>6.0.*</em:maxVersion></Description></em:targetApplication>
  </Description>
</RDF>

